                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/emptyState" android:paddingTop="100dp" android:paddingBottom="80dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_text_10" android:textSize="23sp" android:textColor="@color/ink" android:lineSpacingExtra="3dp" android:textStyle="bold" android:gravity="center" />
                    <Space android:layout_width="1dp" android:layout_height="12dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_main_text_12" android:textSize="15sp" android:textColor="@color/muted" android:lineSpacingExtra="3dp" android:gravity="center" />
                    <Space android:layout_width="1dp" android:layout_height="24dp" />
