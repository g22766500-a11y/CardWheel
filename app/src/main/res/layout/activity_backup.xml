<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="@string/backup_title" app:navigationIcon="@drawable/ic_back" app:navigationContentDescription="@string/activity_add_card_navigationcontentdescription_1" />
<androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/backup_file_title" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/ink" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:text="@string/backup_file_note" android:textSize="14sp" android:textColor="@color/muted" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnSaveBackupFile" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/backup_file_save" app:cornerRadius="14dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnOpenBackupFile" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/backup_file_open" app:cornerRadius="14dp" />
<com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/backupBusy" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="16dp" android:indeterminate="true" android:visibility="gone" />
<TextView android:id="@+id/tvBackupMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/backup_intro_direct" android:textSize="14sp" android:textColor="@color/ink" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnUndoRestore" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/backup_undo" app:cornerRadius="14dp" />
<LinearLayout android:id="@+id/backupPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="24dp">
<TextView android:id="@+id/tvBackupPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/backup_preview" android:textSize="14sp" android:textColor="@color/ink" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnApplyBackup" style="@style/Widget.Material3.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/backup_apply" app:cornerRadius="14dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnCancelBackup" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/backup_cancel" app:cornerRadius="14dp" />
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="12dp" android:text="@string/backup_db_title" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/ink" />
<TextView android:id="@+id/tvBackupIntro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/backup_intro_direct" android:textSize="14sp" android:textColor="@color/ink" />
<com.google.android.material.textfield.TextInputLayout android:id="@+id/tilDbHost" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="@string/backup_url"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etDbHost" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textUri" android:maxLength="253"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/tilDbPort" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="@string/backup_db_port"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etDbPort" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="number" android:maxLength="5" android:text="3306"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/tilDbName" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="@string/backup_db_name"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etDbName" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="text" android:maxLength="64"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/tilDbUser" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="@string/backup_db_user"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etDbUser" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="text" android:maxLength="128"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/tilDbPassword" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="@string/backup_token" app:endIconMode="password_toggle"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etDbPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textPassword" android:maxLength="512" android:saveEnabled="false" android:importantForAutofill="no"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchDbTls" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/backup_tls" android:checked="false" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/backup_tls_note" android:textSize="12sp" android:textColor="@color/muted" />
<LinearLayout android:id="@+id/tlsCertificateArea" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<TextView android:id="@+id/tvDbCertificate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/backup_cert_none" android:textSize="12sp" android:textColor="@color/muted" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnChooseDbCertificate" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/backup_cert_choose" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnClearDbCertificate" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/backup_cert_clear" />
</LinearLayout>
<TextView android:id="@+id/tvSavedConnection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:text="@string/backup_no_connection" android:textSize="12sp" android:textColor="@color/ink" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnConnection" style="@style/Widget.Material3.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/backup_connection" app:cornerRadius="14dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnDisconnect" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/backup_disconnect" app:cornerRadius="14dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnUpload" style="@style/Widget.Material3.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/backup_upload" app:cornerRadius="14dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnRestore" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/backup_restore" app:cornerRadius="14dp" />
</LinearLayout></androidx.core.widget.NestedScrollView></LinearLayout>